  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'You''re the reef keeper! Bring the ecosystem back to life.


    <b>1. 
    Tap a fish</b>  in the food web to learn about it.


    <b>2.  Hold a fish</b> 
    to see what it eats and what eats it.


    <b>3.  Press +</b>  to add it to
    the reef.


    <b>4.  Watch the Ecosystem Health</b>  on the left. Add the right
    mix of species to raise it.


    <b>5.  Use the tabs</b>  below: <b>Food Web</b>
    to add species, <b>Organisms</b> to see your reef and remove any, and <b>Hints</b>
    if you''re stuck.


    Alucia will guide you along the way!'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 396b32e4de413264987437c1faee536c, type: 2}
