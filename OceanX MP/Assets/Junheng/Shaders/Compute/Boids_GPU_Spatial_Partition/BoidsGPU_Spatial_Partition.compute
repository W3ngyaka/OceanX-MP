#pragma kernel BoidSimulationKernel
#define THREAD_GROUP_SIZE 256
#define TARGET_AFFECTER_TYPE 0.0
#define OBSTACLE_AFFECTER_TYPE 1.0
#define PREDATOR_AFFECTER_TYPE 2.0
#define AFFECTS_ALL 255
#define SHAPE_SPHERE 0.5   // shape < 0.5 => sphere, else box
// How quickly obstacle avoidance ramps to its FULL effect as a boid closes on a surface. The effect
// itself is a deflection: the heading is bent until it runs tangential to the obstacle, never further,
// so the fish arcs around a rock instead of rebounding off it (see the avoidance block below).
// Multiplied by proximity and capped, so a value of 5 means "fully tangential once ~55% of the way
// through the margin". Lower = the fish commits to its turn later and cuts it finer; higher = it
// straightens along the obstacle sooner and gives it a wider berth. It is a STEERING rate only — it
// never speeds the fish up (that is reserved for Predator).
#define OBSTACLE_AVOID_STRENGTH 5.0
// NOTE: the distance at which a boid starts steering away from an obstacle is NOT a constant — it is
// per-species, read from boidSchoolInfo.obstacleAvoidanceRangeSquared (authored as
// FishSchoolProperties.ObstacleAvoidanceRange). See the avoidance block in the kernel. Tunnelling at
// speed is still backstopped by the hard ResolveObstaclePenetration pass.

// When reacting to an affecter (predator flee OR obstacle avoidance) the boid SKIPS the slow
// angular-velocity ramp and turns at this multiple of its max angular velocity, so it snaps toward
// the escape heading the frame it enters the zone instead of easing in over ~a second. This is a
// TURN-RATE boost only — it does not change linear speed. Raise for an even snappier reaction.
#define AVOID_TURN_MULTIPLIER 8.0

#include "Assets/Junheng/Shaders/Compute/BoidSimulationData.hlsl"
#include "Assets/Junheng/Shaders/Compute/Quaternion.hlsl"
#include "Assets/Junheng/Shaders/Compute/GPU_Grid_Spatial_Partition/SpatialPartitionUtils.hlsl"

// General simulation properties.
int _TotalBoidCount;
int _TotalAffectersCount;
float _TimeDelta;
// How quickly the ray tail sway eases toward its target each second (frame-rate independent).
// Lower = slower, floatier trailing tail; higher = snappier. Pushed live from the Inspector.
float _TailSwayResponsiveness;
// How fast the HARD penetration backstop may rotate a boid's heading when it gets pushed out of the
// reef, as a MULTIPLE of that species' max angular velocity. Finite, so the backstop eases the heading
// out over a few frames instead of flipping it in one (the up/down "snap" near flat rock/seabed faces).
// 0 or unset => fallback of 3. Pushed live from BoidSimulationGPU so it is tunable in Play mode.
float _ReefBackstopTurnMultiplier;
float3 _SimulationAreaCenter;
float3 _SimulationAreaSize;
// How long (seconds) a boid keeps sprinting after it crosses INTO the simulation bounds. While a
// boid is strictly outside the bounds (freshly spawned off-screen) its per-boid timer is held full;
// once inside, the timer counts down and the boid accelerates until it expires, then settles to
// cruising speed. Driven from BoidSimulationGPU each frame so it is tunable live in the Inspector.
float _EntryBoostDuration;
// Distance (metres) within which an EXITING boid is considered to have reached its parked exit point:
// it then stops dead (speed 0) and holds there instead of overshooting and circling the point, until
// EcosystemSimulationGPU culls the school. Driven from BoidSimulationGPU each frame.
float _ExitStopDistance;

// ---- Reef distance field -----------------------------------------------------------------------
// Baked by OceanX > Bake Reef SDF from the real Rockwork + Corals geometry. Stores UNSIGNED distance to
// the nearest reef surface, in metres. This replaces steering off ~381 obstacle boxes, which were each
// fitted to one mesh but still enclosed mostly open water (a fitted box around SM_Rock_10 is 15,238 m3),
// and which forced the kernel to pick a single "closest" obstacle whose escape direction jumped whenever
// the winner changed. The field is continuous everywhere and costs a handful of texture samples instead
// of hundreds of box tests.
Texture3D<float> _ReefSDF;
SamplerState sampler_linear_clamp;
float3 _ReefSDFMin;          // world-space minimum corner of the baked volume
float3 _ReefSDFSize;         // world-space size of the baked volume
float _ReefSDFVoxelSize;     // metres per voxel; also the finest detail the field can express
int _ReefSDFEnabled;         // 0 => no field baked/assigned; fall back to the affecter obstacles

// Distance to the nearest reef surface.
//
// Outside the baked volume this CLAMPS to the nearest edge voxel rather than reporting "no reef". An
// early version returned a huge constant out there, which put a cliff at the boundary: the gradient below
// is a central difference sampling one voxel either side, so any boid within a voxel of the edge
// differenced against that cliff and got a meaningless escape direction. Clamping keeps the field
// continuous across the boundary. The volume is padded past where fish can swim (see
// ReefSDFVolume.Padding), so the clamped region is somewhere they never reach anyway.
float SampleReefDistance(float3 worldPosition)
{
    float3 uvw = saturate((worldPosition - _ReefSDFMin) / _ReefSDFSize);
    return _ReefSDF.SampleLevel(sampler_linear_clamp, uvw, 0);
}

// Raw (unnormalised) gradient of the distance field, by central differences. Points AWAY from the nearest
// surface, which is exactly the escape direction. Returned unnormalised on purpose: its LENGTH says how
// trustworthy the direction is. The field is unsigned, so at a surface voxel the distance is 0 and is a
// local minimum — the gradient there collapses to ~0 and carries no usable direction. Callers must check.
float3 ReefSDFGradientRaw(float3 worldPosition)
{
    float h = max(_ReefSDFVoxelSize, 1e-3);
    float dx = SampleReefDistance(worldPosition + float3(h, 0.0, 0.0)) - SampleReefDistance(worldPosition - float3(h, 0.0, 0.0));
    float dy = SampleReefDistance(worldPosition + float3(0.0, h, 0.0)) - SampleReefDistance(worldPosition - float3(0.0, h, 0.0));
    float dz = SampleReefDistance(worldPosition + float3(0.0, 0.0, h)) - SampleReefDistance(worldPosition - float3(0.0, 0.0, h));
    return float3(dx, dy, dz);
}

// Buffer containing all boids in the simulation.
StructuredBuffer<BoidInfo> _Boids;
RWStructuredBuffer<BoidInfo> _BoidsOutput;
// Buffer containing offset for each cell in the spatial partition based on 
// the total number of boids in cells before. 
StructuredBuffer<uint> _CellsOffsetsBuffer;
// Buffer containing informations about every boid school used in the simulation.
StructuredBuffer<BoidSchoolInfo> _BoidSchools;
// Buffer containing all obstacles and targets of the simulation that
// can affect the behavior of the boids.
StructuredBuffer<Affecter> _Affecters;

// ---- Moray serpentine trail (path-following body) --------------------------------------------
// A short ring buffer of recent HEAD positions per moray, appended at a fixed arclength spacing so
// the render shader can lay the long eel body along the path the head actually travelled (instead of
// rigidly rotating a stiff mesh about its centre). Only the moray species writes here; every other
// boid ignores it. _MorayGroupId < 0 disables the whole feature (no moray active) and the append is
// skipped, but the buffers are still bound (an unbound RWStructuredBuffer is a hard error on some
// platforms). One thread owns one moray, so the ring writes never race.
RWStructuredBuffer<float4> _MorayTrail;       // xyz = world sample position; length _MorayCount*_MorayTrailCount
RWStructuredBuffer<int>    _MorayTrailCursor; // newest ring index per moray;    length _MorayCount
int   _MorayGroupId;       // species group id (low byte of boidID) of the moray; -1 => no moray active
int   _MorayBufferOffset;  // originalIndex offset of the moray slice in the global buffer
int   _MorayCount;         // number of moray instances
int   _MorayTrailCount;    // K ring samples per moray
float _MorayTrailSpacing;  // metres of head travel between appended samples

// ---- Moray cave FREEZE (rest-in-cave) --------------------------------------------------------
// The same cave anchors the render pose uses (MorayCaveDirector -> SetMorayRestAnchors). A moray whose
// head is near an anchor with a non-zero weight is eased onto that anchor and held there, so the fish
// physically swims the last stretch into the cave and STOPS — a single boid can't slow below cruising,
// so without this it would orbit the cave forever and no still resting pose is possible. w=1 pins it
// exactly; the render shader then lays the (now stationary) body into the curl. Empty (count 0) => inert.
#define MORAY_MAX_REST_ANCHORS 8
float4 _MorayRestAnchorPos[MORAY_MAX_REST_ANCHORS]; // xyz = cave-mouth world pos, w = rest weight 0..1
int   _MorayRestAnchorCount;                        // number of active anchors (0 => no freezing)
float _MorayRestMatchRadius;                        // how near the head must be to bind to an anchor (m)

float InverseLerp(float minValue, float maxValue, float value)
{
    return (value - minValue) / (maxValue - minValue);
}

// -------------------------------------------------------------------------
// Affecter shape helpers — an affecter's influence volume is either a sphere
// (radius) or an oriented box (halfExtents + rotation). These give one
// surface-distance / inside test / away-direction that works for both shapes.
// -------------------------------------------------------------------------

// Brings a world position into the affecter's local (box) space using the
// inverse (conjugate) of the box rotation. For a unit quaternion the conjugate
// is the inverse, so this un-rotates the world offset into axis-aligned space.
float3 AffecterLocalPosition(Affecter affecter, float3 worldPosition)
{
    float4 inverseRotation = float4(-affecter.rotation.xyz, affecter.rotation.w);
    return Multiply(InitializeQuaternion(inverseRotation), worldPosition - affecter.position);
}

// Distance from a boid to the affecter's influence surface. 0 when inside.
float AffecterSurfaceDistance(Affecter affecter, float3 boidPosition)
{
    if(affecter.shape < SHAPE_SPHERE)
    {
        return max(0.0, length(affecter.position - boidPosition) - affecter.radius);
    }
    float3 delta = abs(AffecterLocalPosition(affecter, boidPosition)) - affecter.halfExtents;
    return length(max(delta, 0.0));
}

// Is the boid inside the affecter's influence volume?
bool BoidInsideAffecter(Affecter affecter, float3 boidPosition)
{
    if(affecter.shape < SHAPE_SPHERE)
    {
        return length(affecter.position - boidPosition) <= affecter.radius;
    }
    float3 local = AffecterLocalPosition(affecter, boidPosition);
    return all(abs(local) <= affecter.halfExtents);
}

// World-space direction pointing away from the affecter centre (used to steer clear).
// For a SPHERE this is away from the centre — exact, and what a predator flee wants.
// For a BOX it is away from the CLOSEST POINT ON THE SURFACE, not the centre. Measuring the distance to
// the surface (AffecterSurfaceDistance) but the direction from the centre used the two reference points
// inconsistently: the escape heading then depended on the rock's overall shape rather than on the part of
// it the fish was about to hit, so a fish swimming alongside a long, low rock whose centre sat below it
// was pushed UP instead of sideways, and the direction swung around as it passed.
float3 AffecterAwayDirection(Affecter affecter, float3 boidPosition)
{
    if(affecter.shape < SHAPE_SPHERE)
    {
        float3 awayVector = boidPosition - affecter.position;
        float lengthSquared = dot(awayVector, awayVector);
        return lengthSquared > 1e-6 ? awayVector * rsqrt(lengthSquared) : float3(0.0, 1.0, 0.0);
    }

    // Box: the closest point on it is the local position clamped to the half-extents.
    float3 localPosition = AffecterLocalPosition(affecter, boidPosition);
    float3 closestLocal  = clamp(localPosition, -affecter.halfExtents, affecter.halfExtents);
    float3 localAway     = localPosition - closestLocal;
    if(dot(localAway, localAway) > 1e-6)
    {
        return normalize(Multiply(InitializeQuaternion(affecter.rotation), localAway));
    }

    // Inside the box, where "outward" is undefined — use the nearest face's normal, matching what
    // ResolveObstaclePenetration picks when it pushes a boid back out.
    float3 penetration = affecter.halfExtents - abs(localPosition);
    float3 localNormal;
    if(penetration.x <= penetration.y && penetration.x <= penetration.z)
        localNormal = float3(localPosition.x >= 0.0 ? 1.0 : -1.0, 0.0, 0.0);
    else if(penetration.y <= penetration.z)
        localNormal = float3(0.0, localPosition.y >= 0.0 ? 1.0 : -1.0, 0.0);
    else
        localNormal = float3(0.0, 0.0, localPosition.z >= 0.0 ? 1.0 : -1.0);
    return normalize(Multiply(InitializeQuaternion(affecter.rotation), localNormal));
}

// Rotate 'fromDir' toward 'toDir' by AT MOST 'maxRadians' (a capped slerp). The penetration backstops
// use this so they ease a boid's heading out of the reef over a few frames instead of snapping it in one
// — same escape direction, no instant flip. Inputs need not be pre-normalized.
float3 RotateDirectionTowards(float3 fromDir, float3 toDir, float maxRadians)
{
    fromDir = normalize(fromDir);
    toDir   = normalize(toDir);
    float cosA = clamp(dot(fromDir, toDir), -1.0, 1.0);
    float ang  = acos(cosA);
    if(ang <= maxRadians || ang < 1e-5)
    {
        return toDir;                 // already within the cap — take the whole (tiny) remainder
    }
    float t = maxRadians / ang;
    float s = sin(ang);
    if(s < 1e-5)
    {
        return toDir;                 // degenerate (near anti-parallel); slerp undefined, just accept
    }
    return normalize((sin((1.0 - t) * ang) * fromDir + sin(t * ang) * toDir) / s);
}

// Per-frame cap (radians) on how far a penetration backstop may swing this boid's heading, from the
// species' max angular velocity scaled by _ReefBackstopTurnMultiplier. Emergency-fast but finite.
float ReefBackstopMaxTurn(BoidSchoolInfo boidSchoolInfo)
{
    float mult = _ReefBackstopTurnMultiplier > 0.0 ? _ReefBackstopTurnMultiplier : 3.0;
    return radians(max(boidSchoolInfo.maxAngularVelocity, 1.0) * mult) * _TimeDelta;
}

// HARD separation — the guarantee behind the steering. If a boid still ended the frame INSIDE an
// obstacle (a sprinting entry/exit fish can outrun its own turn rate, or a school push can shove one
// in), snap its POSITION back out to the nearest surface point and turn its heading along that surface
// (rate-limited, so the heading banks out smoothly instead of flipping). With this in place fish can
// never visibly tunnel through rocks, regardless of speed or steering state.
void ResolveObstaclePenetration(Affecter obstacle, inout BoidInfo boidInfo, BoidSchoolInfo boidSchoolInfo)
{
    float backstopMaxTurn = ReefBackstopMaxTurn(boidSchoolInfo);

    if(obstacle.shape < SHAPE_SPHERE)
    {
        float3 fromCenter = boidInfo.position - obstacle.position;
        float distanceFromCenter = length(fromCenter);
        if(distanceFromCenter >= obstacle.radius) return;

        float3 surfaceNormal = distanceFromCenter > 1e-4 ? fromCenter / distanceFromCenter : float3(0.0, 1.0, 0.0);
        boidInfo.position = obstacle.position + surfaceNormal * (obstacle.radius + 0.05);
        float inwardAmount = dot(boidInfo.direction, surfaceNormal);
        if(inwardAmount < 0.0)
        {
            float3 correctedDir = normalize(boidInfo.direction - surfaceNormal * inwardAmount);
            boidInfo.direction = RotateDirectionTowards(boidInfo.direction, correctedDir, backstopMaxTurn);
        }
        return;
    }

    float3 localPosition = AffecterLocalPosition(obstacle, boidInfo.position);
    if(any(abs(localPosition) >= obstacle.halfExtents)) return;

    // Inside the box: push out through the face with the smallest penetration — EXCEPT when that would
    // eject the boid below the world floor.
    //
    // Obstacle volumes wrap coral and rock that SIT ON the seabed, so 244 of this reef's 381 boxes reach
    // below the simulation floor (the lowest by ~21m). A bottom-dwelling fish that clips the LOWER half
    // of one has its smallest penetration through the BOTTOM face, so "cheapest way out" was straight
    // down — which is how rays ended up swimming underneath the sand. There is never anything worth
    // ejecting to down there, so if the cheapest exit goes under the floor, take the cheapest horizontal
    // one instead and let the boid leave sideways.
    float3 penetration = obstacle.halfExtents - abs(localPosition);
    float worldFloorY = _SimulationAreaCenter.y - _SimulationAreaSize.y * 0.5;

    // Where would a Y-face ejection actually land? The box may be rotated, so test the world result
    // rather than assuming local -Y points down.
    float ySide = localPosition.y >= 0.0 ? 1.0 : -1.0;
    float3 yLocal = localPosition;
    yLocal.y = ySide * (obstacle.halfExtents.y + 0.05);
    float3 yWorld = Multiply(InitializeQuaternion(obstacle.rotation), yLocal) + obstacle.position;
    bool yExitIsUnderFloor = yWorld.y < worldFloorY;

    float3 localNormal;
    if(!yExitIsUnderFloor && penetration.y <= penetration.x && penetration.y <= penetration.z)
    {
        localNormal = float3(0.0, ySide, 0.0);
        localPosition.y = yLocal.y;
    }
    else if(penetration.x <= penetration.z)
    {
        float side = localPosition.x >= 0.0 ? 1.0 : -1.0;
        localNormal = float3(side, 0.0, 0.0);
        localPosition.x = side * (obstacle.halfExtents.x + 0.05);
    }
    else
    {
        float side = localPosition.z >= 0.0 ? 1.0 : -1.0;
        localNormal = float3(0.0, 0.0, side);
        localPosition.z = side * (obstacle.halfExtents.z + 0.05);
    }

    // Back to world space (rotate with the box's own rotation, the inverse of AffecterLocalPosition).
    boidInfo.position = Multiply(InitializeQuaternion(obstacle.rotation), localPosition) + obstacle.position;
    // Last resort: a rotated box can send even a horizontal ejection below the floor. Nothing should ever
    // end up under the seabed, so hard-clamp it.
    boidInfo.position.y = max(boidInfo.position.y, worldFloorY);
    float3 worldNormal = Multiply(InitializeQuaternion(obstacle.rotation), localNormal);
    float inwardAmount = dot(boidInfo.direction, worldNormal);
    if(inwardAmount < 0.0)
    {
        float3 correctedDir = normalize(boidInfo.direction - worldNormal * inwardAmount);
        boidInfo.direction = RotateDirectionTowards(boidInfo.direction, correctedDir, backstopMaxTurn);
    }
}

// Distance-field version of the hard penetration backstop. Keeps a boid at least one voxel clear of the
// reef surface, and slides its heading along that surface rather than letting it drive further in.
//
// The field is UNSIGNED, which shapes how this has to work. Just outside the surface the gradient is
// strong and points cleanly outward, so we push along it. But DEEP inside a thick, flat mass — a rock
// slab lying on the seabed — every neighbouring voxel is equally solid, so the local gradient collapses
// to nothing and there is no "which way is out" to read.
void ResolveReefPenetration(inout BoidInfo boidInfo, BoidSchoolInfo boidSchoolInfo)
{
    // One voxel is the finest the field can resolve, so it is also the closest we can meaningfully
    // hold a boid to the surface.
    float clearance = max(_ReefSDFVoxelSize, 1e-3);
    float distance = SampleReefDistance(boidInfo.position);
    if(distance >= clearance)
    {
        return;
    }

    // Per-frame cap on the heading correction — banks the boid out smoothly instead of snapping it.
    float backstopMaxTurn = ReefBackstopMaxTurn(boidSchoolInfo);

    float3 gradient = ReefSDFGradientRaw(boidInfo.position);
    float gradientLength = length(gradient);

    if(gradientLength > 1e-4)
    {
        float3 surfaceNormal = gradient / gradientLength;
        boidInfo.position += surfaceNormal * (clearance - distance);

        float inwardAmount = dot(boidInfo.direction, surfaceNormal);
        if(inwardAmount < 0.0)
        {
            float3 correctedDir = normalize(boidInfo.direction - surfaceNormal * inwardAmount);
            boidInfo.direction = RotateDirectionTowards(boidInfo.direction, correctedDir, backstopMaxTurn);
        }
    }
    else
    {
        // Buried in a mass too thick for the local gradient to escape (a floor-level slab). Climb toward
        // OPEN WATER, which in a reef sitting on the seabed is reliably straight up: the field always
        // gains distance with height until it clears the surface. Pushing up one voxel per frame walks
        // the boid out over a frame or two.
        //
        // The previous version instead backed out along the boid's own heading, which created the exact
        // "swims forward forever but never moves" trap: near the seabed the heading is horizontal, so it
        // shoved the boid sideways within the flat slab, then the floor clamp below pinned it back at the
        // floor, and it re-entered the same voxel the next frame. Climbing up escapes; backing out did not.
        boidInfo.position.y += clearance;
        // Bias the heading upward too, but ease into it (rate-limited) so a fish buried in a slab climbs
        // out smoothly instead of flicking straight up.
        float3 correctedUp = normalize(boidInfo.direction + float3(0.0, 1.0, 0.0));
        boidInfo.direction = RotateDirectionTowards(boidInfo.direction, correctedUp, backstopMaxTurn);
    }

    // Nothing may end up under the seabed. The reef sits ON the floor, so pushing "out" of it can point
    // downward through the sand.
    float worldFloorY = _SimulationAreaCenter.y - _SimulationAreaSize.y * 0.5;
    boidInfo.position.y = max(boidInfo.position.y, worldFloorY);
}

// Function returns the closest affecter of the specified affecter type to the current boid.
// If no affecter of that type exists, returns a harmless "null" affecter (Sphere, radius -1)
// so that BoidInsideAffecter() / distance tests always report "not affected" instead of
// reading an uninitialized struct (which could make boids flee/avoid nothing at random).
Affecter GetClosestAffecter(BoidInfo boidInfo, float affecterType)
{
    // Initial variables — closestAffecter defaults to a no-op sphere with negative radius.
    Affecter closestAffecter = (Affecter)0;
    closestAffecter.radius = -1.0;                 // negative radius => never "inside"
    closestAffecter.halfExtents = float3(-1, -1, -1);
    closestAffecter.shape = 0.0;                    // sphere path (uses the negative radius)
    closestAffecter.rotation = float4(0, 0, 0, 1); // identity, just in case
    closestAffecter.affecterType = -1.0;
    float closestAffecterDistance = -1;

    int rawBoidIdBits = asint(boidInfo.boidID);
    int boidId = rawBoidIdBits & 0xFF;
    // Bits 8-15 are the boid's FLOCK id (globally unique, see CalculateSchoolBehaviourDirection).
    // A school's Target carries its flock id in boidSubGroupId and AFFECTS_ALL in boidGroupId, so the
    // match below is on flock alone. That is what lets a merged shoal -- possibly of two different
    // species -- follow one shared target, which it must: if the merged schools kept separate targets,
    // cohesion would hold them together while their targets pulled them apart.
    int boidFlockId = (rawBoidIdBits >> 8) & 0xFF;

    // Go through all affecters and find the one closest to the provided boid position.
    for(int i = 0; i < _TotalAffectersCount; i++)
    {
        // Fetch the affecter and check its type. If its type is not the one we're focues on,
        // just skip over it. 
        Affecter affecter = _Affecters[i];
        if(affecter.affecterType != affecterType)
        {
            continue;
        }

        // Skip affecters that don't apply to this boid: either they target a different species, or they
        // target a specific flock that this boid is not in. AFFECTS_ALL on either field means "any".
        int affecterGroupId = (int)affecter.boidGroupId;
        int affecterFlockId = (int)affecter.boidSubGroupId;
        if((affecterGroupId != AFFECTS_ALL && boidId != affecterGroupId) ||
           (affecterFlockId != AFFECTS_ALL && boidFlockId != affecterFlockId))
        {
            continue;
        }

        // Get the distance between the boid and the affecter (shape-aware: sphere or box) and
        // cache the affecter if it's the closest one. Or if there isn't a closest
        // affecter initialized yet.
        float distanceFromAffecter = AffecterSurfaceDistance(affecter, boidInfo.position);
        if(closestAffecterDistance < 0.0 || distanceFromAffecter < closestAffecterDistance) {
            closestAffecterDistance = distanceFromAffecter;
            closestAffecter = affecter;
        }
    }

    // Return the closest affecter to the boid position.
    return closestAffecter;
}

// Sums an escape direction from EVERY obstacle within the boid's avoid margin, each weighted by how
// close it is, and reports the strongest single proximity through outProximity.
//
// Why not just use the closest obstacle (GetClosestAffecter)? Because "closest" is a step function. The
// reef is 381 overlapping boxes, over 150 of them more than 6m across, so as a fish swims the nearest
// one keeps changing — and each obstacle's away-vector points somewhere completely different. Measured
// along a 40m path through this reef, the escape direction teleported by up to 58 DEGREES between two
// consecutive 5cm steps. The fish then chases that discontinuity at its full turn rate, which is the
// abrupt jerk. No amount of smoothing downstream can rescue a target direction that is itself
// discontinuous — it has to be continuous at the source.
//
// A proximity-weighted sum is continuous: as one obstacle fades out of range and another fades in, their
// contributions cross over smoothly and the blended direction rotates instead of snapping. It also
// behaves better in a crevice, where several rocks each push a little and the fish threads between them
// rather than fixating on whichever is momentarily nearest.
float3 AccumulateObstacleAvoidance(BoidInfo boidInfo, float avoidMargin, out float outProximity)
{
    float3 accumulated = float3(0.0, 0.0, 0.0);
    outProximity = 0.0;

    int rawBoidIdBits = asint(boidInfo.boidID);
    int boidId = rawBoidIdBits & 0xFF;
    int boidFlockId = (rawBoidIdBits >> 8) & 0xFF;

    for(int i = 0; i < _TotalAffectersCount; i++)
    {
        Affecter affecter = _Affecters[i];
        if(affecter.affecterType != OBSTACLE_AFFECTER_TYPE)
        {
            continue;
        }

        // Same group/flock filtering GetClosestAffecter applies, so an obstacle can still be scoped to
        // one species or one flock if it is ever authored that way.
        int affecterGroupId = (int)affecter.boidGroupId;
        int affecterFlockId = (int)affecter.boidSubGroupId;
        if((affecterGroupId != AFFECTS_ALL && boidId != affecterGroupId) ||
           (affecterFlockId != AFFECTS_ALL && boidFlockId != affecterFlockId))
        {
            continue;
        }

        float surfaceDistance = AffecterSurfaceDistance(affecter, boidInfo.position);
        if(surfaceDistance > avoidMargin)
        {
            continue;
        }

        // 0 at the margin edge, 1 at the surface. Squared for a softer onset, and — the point here — it
        // reaches exactly 0 at the margin edge, so an obstacle's contribution fades IN and OUT smoothly
        // instead of appearing and vanishing.
        float proximity = saturate(1.0 - surfaceDistance / avoidMargin);
        proximity *= proximity;

        accumulated += AffecterAwayDirection(affecter, boidInfo.position) * proximity;
        outProximity = max(outProximity, proximity);
    }
    return accumulated;
}

// Update the swim motion time based on the current swimming motion intensity. This time is used by the rendering shader
// to correctly visualize the swimming motion pattern of this boid.
void UpdateSwimMotionTime(inout BoidInfo boidInfo) 
{
    float swimPlaybackSpeed = lerp(boidInfo.minPlaybackSpeed, boidInfo.maxPlaybackSpeed, boidInfo.swimMotionIntensity);
    boidInfo.currentSwimTime += _TimeDelta * swimPlaybackSpeed;
}

// Update the swim motion intensity of the boid based on the current total acceleration. NOTE: The swim intensity
// is guided by acceleration, not velocity!
void UpdateSwimMotionIntensity(BoidSchoolInfo boidSchoolInfo, inout BoidInfo boidInfo)
{
    float movementIntensity = InverseLerp(0.0, boidSchoolInfo.maxAcceleration, boidInfo.acceleration);
    float rotationIntensity = InverseLerp(0.0, boidSchoolInfo.maxAngularAcceleration, boidInfo.angularAcceleration);
    boidInfo.swimMotionIntensity = saturate(max(movementIntensity, rotationIntensity));
}

// Update the current position of the boid based on the current movement direction, speed and time passed.
void UpdatePosition(inout BoidInfo boidInfo)
{
    float3 newPosition = boidInfo.position + boidInfo.direction * _TimeDelta * boidInfo.speed;
    boidInfo.position = newPosition;
}

// Function updates the movement speed and acceleration of the boid based on its need to accelerate this frame or not.
void UpdateMovementSpeed(bool shouldAccelerate, BoidSchoolInfo boidSchoolInfo, inout BoidInfo boidInfo)
{
    // If the boid should accelerate, adde the increase the movement jerk (rate of change in acceleration).
    float currentJerk = shouldAccelerate ? boidSchoolInfo.movementJerk : 0.0;
    float deceleration = currentJerk > 0.0 ? 0.0 : boidSchoolInfo.deceleration;
    // Update the current acceleration and speed.
    float currentAcceleration = clamp(boidInfo.acceleration + (currentJerk - deceleration) * _TimeDelta, 0.0, boidSchoolInfo.maxAcceleration);
    float currentMovementSpeed = boidInfo.speed;

    // If the current speed will be lower than the cruising speed that the boid is constantly trying to maintain, increase
    // the acceleration to correct the movement speed to the desired cruising speed.
    if((currentMovementSpeed + (currentAcceleration - boidSchoolInfo.waterFriction * currentMovementSpeed) * _TimeDelta) < boidSchoolInfo.cruisingSpeed) 
    {
        currentAcceleration = boidSchoolInfo.cruisingSpeed * boidSchoolInfo.waterFriction;
    }

    // Update the current movement speed and clamp its value between the desired range.
    currentMovementSpeed += (currentAcceleration - boidSchoolInfo.waterFriction * currentMovementSpeed) * _TimeDelta;
    currentMovementSpeed = clamp(currentMovementSpeed, boidSchoolInfo.cruisingSpeed, boidSchoolInfo.maxSpeed);

    // Update the boid movement properties.
    boidInfo.acceleration = currentAcceleration;
    boidInfo.speed = currentMovementSpeed;
}

// Function updates the current movement direction of the boid toward the target direction it would like to move
// based on the current angular acceleration and movement speed.
void UpdateMovementDirection(float3 targetDirection, BoidSchoolInfo boidSchoolInfo, inout BoidInfo boidInfo, bool snapTurn)
{
    // Calculate the angle that the fish would need to steer in order to face the desired movement direction.
    quaternion rotationTowardTarget = LookRotation(targetDirection, float3(0, 1, 0));
    quaternion currentRotation = LookRotation(boidInfo.direction, float3(0, 1, 0));
    float angleTowardTarget = Angle(currentRotation, rotationTowardTarget);

    // Based on the angle the fish needs to steer, check if we need to increase the angular acceleration or not.
    // Using 50 degrees as an angle threshold for starting to speed up at maximum acceleration.
    float currentAngularJerk = boidInfo.angularVelocity < angleTowardTarget ? lerp(0.0, boidSchoolInfo.angularJerk, (angleTowardTarget - boidInfo.angularVelocity) / 50.0) : 0.0;
    float angularDeceleration = currentAngularJerk > 0.0 ? 0.0 : boidSchoolInfo.angularDeceleration;
    // Update the current angular acceleration and speed.
    float currentAngularAcceleration = clamp(boidInfo.angularAcceleration + (currentAngularJerk - angularDeceleration) * _TimeDelta, 0.0, boidSchoolInfo.maxAngularAcceleration);
    float currentAngularVelocity = clamp(boidInfo.angularVelocity + currentAngularAcceleration * _TimeDelta, 0.0, boidSchoolInfo.maxAngularVelocity);

    // Affecter reaction snap: bypass the ramp entirely — turn at a high multiple of max angular
    // velocity and apply the rotation fully — so the boid whips toward the escape heading the frame
    // it enters the zone. Turn-rate only; linear speed is handled separately (no speed-up here).
    float appliedAngularVelocity = snapTurn ? boidSchoolInfo.maxAngularVelocity * AVOID_TURN_MULTIPLIER : currentAngularVelocity;
    float rotationSmoothing = snapTurn ? 1.0 : 0.85;

    // Rotate the direction toward the desired one based on the (possibly boosted) angular velocity.
    quaternion newRotation = RotateTowards(currentRotation, rotationTowardTarget, appliedAngularVelocity * _TimeDelta);
    // Smooth the rotation based on the previous one, to produce smoother movement (full apply when snapping).
    newRotation = Slerp(currentRotation, newRotation, rotationSmoothing);

    // Keep angular velocity primed while snapping so the reaction stays instant across the whole zone.
    if(snapTurn)
    {
        currentAngularVelocity = boidSchoolInfo.maxAngularVelocity;
    }

    // If we haven't increased the angular acceleration this frame, this means that the angular velocity should slowly deteriorate.
    if(currentAngularJerk <= 0.0)
    {
        currentAngularVelocity = clamp(currentAngularVelocity - boidSchoolInfo.angularVelocityReduction * _TimeDelta, 0.0, boidSchoolInfo.maxAngularVelocity);
    }

    // Update the current movement acceleration based on the percentage of the angular acceleration for this frame. 
    // This is due to translation of movement energy released while swimming to rotate.
    float currentAcceleration = boidInfo.acceleration + currentAngularAcceleration * boidSchoolInfo.rotationEffectOnSpeed * _TimeDelta;

    // Calculate the current movement direction based on the current rotation.
    float3 currentMovementDirection = Multiply(newRotation, float3(0, 0, 1));

    // Signed turn rate for render-time tail deformation (ray wing shader). The cross product of the old
    // and new heading has the yaw handedness in its Y component; the magnitude comes from the (unsigned)
    // angular velocity as a fraction of the species max, so it stays smooth and framerate independent.
    // 0 when swimming straight. Computed here while boidInfo.direction still holds the previous heading.
    float3 turnCross = cross(boidInfo.direction, currentMovementDirection);
    float turnStrength = boidSchoolInfo.maxAngularVelocity > 1e-5 ? saturate(currentAngularVelocity / boidSchoolInfo.maxAngularVelocity) : 0.0;
    float signedTurnTarget = (turnCross.y >= 0.0 ? 1.0 : -1.0) * turnStrength;

    // Ease the stored sway toward the target so the tail TRAILS the body like a real stingray's does,
    // instead of snapping to the full pose the instant the ray starts turning. Frame-rate independent
    // exponential smoothing; responsiveness is pushed live from the Inspector (falls back to a sensible
    // default when a path doesn't set it, e.g. the brute-force sim).
    float tailResponsiveness = _TailSwayResponsiveness > 0.0 ? _TailSwayResponsiveness : 4.0;
    float tailSmoothing = 1.0 - exp(-_TimeDelta * tailResponsiveness);
    float signedTurnRate = lerp(boidInfo.signedTurnRate, signedTurnTarget, tailSmoothing);

    // Update boid movement properties that were changed during these direction updates.
    boidInfo.acceleration = currentAcceleration;
    boidInfo.direction = currentMovementDirection;
    boidInfo.angularVelocity = currentAngularVelocity;
    boidInfo.angularAcceleration = currentAngularAcceleration;
    boidInfo.signedTurnRate = signedTurnRate;
}

// Function calculates the separation vector of the boid that will steer it away from the neighboring boid.
// The closer the boids are, the stronger the separation vector.
float3 GetSeparationVector(float3 boidPosition, float3 neighborPosition, float inverseSeparationRangeSquared)
{
    float3 vectorAwayFromNeighbor = boidPosition - neighborPosition;
    float distanceSquared = dot(vectorAwayFromNeighbor, vectorAwayFromNeighbor);

    return vectorAwayFromNeighbor * saturate(1.0 - distanceSquared * inverseSeparationRangeSquared);
}

// Function calculates the new desired movement direction of the boid based on its neighboring boids and the 
// closest target that the boid is trying to reach. The neighboring boids affect the movement since the 
// boid is trying to move in the same direction as them, while keeping a safe distance from each boid in the group.
float3 CalculateSchoolBehaviourDirection(int boidIndex, BoidSchoolInfo boidSchoolInfo, inout BoidInfo boidInfo) 
{
    // Initialize parameters for behavior.
    float3 separation = float3(0,0,0);
    float3 alignmentDirection = boidInfo.direction;
    float3 cohesionPosition = boidInfo.position;
    
    // Find the closest target to this boid, this is the target that this boid will try to reach.
    Affecter target = GetClosestAffecter(boidInfo, TARGET_AFFECTER_TYPE);
    
    // Caching the inverse of the separation range so that we could use multiplication instead of division
    // when calculating the separation intensity of each neighboring boid.
    float inverseSeparationRangeSquared = 1.0 / boidSchoolInfo.separationRangeSquared;

    // Get ID of the cell that this boid belons to.
    // These strides MUST match the 1D layout GetCellID() writes: cellID = (X*Y)*z + X*y + x.
    // So one step in Y is _CellCountX cells, and one step in Z is _CellCountX * _CellCountY cells.
    // (This read _CellCountX * _CellCountZ, which only coincides with the real stride on a grid where
    // CellCountY == CellCountZ. On a wide, shallow ocean grid the Z steps landed on unrelated cells,
    // so a fish never saw the neighbours in the slabs in front of and behind it.)
    uint cellID = GetCellID(boidInfo.position);
    uint cellOffsetY = _CellCountX;
    uint cellOffsetZ = _CellCountX * _CellCountY;

    // Initialize helper variables for averaging directions and their strength.
    int neighborsCount = 0;
    int separationNeighborsCount = 0;

    // Species ID (bits 0-7) and flock ID (bits 8-15) of this boid.
    //   species = what this fish IS: it indexes _BoidSchools[] for physics, and its ordering encodes
    //             body size (see the separation test below).
    //   flock   = who this fish SWIMS WITH. Globally unique across all species, assigned on the CPU.
    // Keeping those two separate is what allows a mixed-species shoal: two schools of different species
    // can share a flock ID and cohere as one group while each fish keeps its own speed and size rank.
    int thisBoidId = asint(boidInfo.boidID) & 0xFF;
    int thisFlockId = (asint(boidInfo.boidID) >> 8) & 0xFF;

    // For each neighboring cell, of the one that the boid is currently located in, check the distance of neighboring
    // boids and update the cohesion, alignment and separation vectors.
    for(uint cellIndexZ = cellID - cellOffsetZ; cellIndexZ <= cellID + cellOffsetZ; cellIndexZ += cellOffsetZ)
    {
        for(uint cellIndexY = cellIndexZ - cellOffsetY; cellIndexY <= cellIndexZ + cellOffsetY; cellIndexY += cellOffsetY)
        {
            // Indices of the first and the last neighboring cell that we're interested in. Make sure to clamp
            // the indices between the total number of cells.
            uint firstCellIndex = max(0, cellIndexY - 1);
            uint lastCellIndex = min(_TotalCellCount - 1, cellIndexY + 1);

            // Since each cell contains the total number of boids in that cell and all other cells before it, we can 
            // use that value of one cell before to get an index of the first boid of the desired cell. Of course,
            // if the current cell is the first one, the first index is 0 since there is no cell before this one.
            uint startBoidIndex = firstCellIndex == 0 ? 0 : _CellsOffsetsBuffer[firstCellIndex - 1];
            uint endBoidIndex = _CellsOffsetsBuffer[lastCellIndex];

            // For each boid located in those cells, calculate the cohesion, separation and alignment vectors.
            for(uint i = startBoidIndex; i < endBoidIndex; i++) {
                // The boid shouldn't affect itself.
                if(i == (uint)boidIndex) 
                {
                    continue;
                }

                BoidInfo otherBoidInfo = _Boids[i];
                int otherBoidID = asint(otherBoidInfo.boidID) & 0xFF;
                // If the boid is a smaller fish species, it shouldn't affect our behaviour.
                if(otherBoidID < thisBoidId)
                {
                    continue;
                }

                // Check the distance to the other boid and see if its outside our vision distance. This is the distance
                // each boid uses as a "sensing distance" to feel the presence of other boids.
                float3 boidToOtherBoidVector = (otherBoidInfo.position - boidInfo.position);
                float distanceSquared = dot(boidToOtherBoidVector, boidToOtherBoidVector);
                if(distanceSquared > boidSchoolInfo.visionRangeSquared || distanceSquared <= 0.0) 
                {
                    continue;
                }

                // If the neighboring boid is very cloe to us, check if we should start separating from it or not.
                if(distanceSquared < boidSchoolInfo.separationRangeSquared)
                {
                    separation += GetSeparationVector(boidInfo.position, otherBoidInfo.position, inverseSeparationRangeSquared);
                    separationNeighborsCount++;
                }

                // Cohere and align ONLY with boids in the same flock. Flock IDs are globally unique, so for
                // an ordinary school this is exactly the old "same species and same sub-group" test. It
                // differs only when the CPU has deliberately given two schools the same flock ID: a merge.
                // Because the species is NOT re-checked here, that merge may join two schools of DIFFERENT
                // species into one mixed shoal -- they cohere and align as one group while each fish keeps
                // its own physics (via its own species ID above) and its own size rank in the separation
                // test. Separation is unaffected: it still applies to same-species and all larger fish,
                // flock or no flock.
                int otherFlockId = (asint(otherBoidInfo.boidID) >> 8) & 0xFF;
                if(otherFlockId != thisFlockId)
                {
                    continue;
                }

                // Updating alignment and cohesion vectors.
                alignmentDirection += otherBoidInfo.direction;
                cohesionPosition += otherBoidInfo.position;
                neighborsCount++;
            }
        }
    }

    // Average the alignment direction and cohesion position over every sample that went into them.
    // Both accumulators were SEEDED with this boid's own direction/position before the neighbour loop,
    // so the sample count is neighborsCount + 1, not neighborsCount. Dividing by neighborsCount scaled
    // the centroid by (N+1)/N about the WORLD ORIGIN, which dragged the cohesion target |centroid| / N
    // metres away from the school — 1-2 m for a full school, but tens of metres whenever a fish had only
    // a neighbour or two. With no neighbours the factor is 1.0, which leaves the seeds untouched (the
    // neighborsCount == 0 cases below then fall back to the boid's own heading, as before).
    float averagingFactor = 1.0 / (neighborsCount + 1);
    alignmentDirection *= averagingFactor;
    cohesionPosition *= averagingFactor;

    // Average the separation direction.
    if(separationNeighborsCount > 0) {
        separation /= separationNeighborsCount;
    }

    // If there were no neighbors affecting this boid, the cohesion will be the current direction of movement.
    float3 cohesionDirection = neighborsCount == 0 ? boidInfo.direction : normalize(cohesionPosition - boidInfo.position);

    // Scale the separation vector based on the distance from the closest neighbor.
    float separationSquaredLength = dot(separation, separation);
    float3 separationDirection = separationNeighborsCount > 0 && separationSquaredLength > 0 ? normalize(separation) : boidInfo.direction;

    // Check if the boid has already reached the "reaching" distance from the target. If so, just continue moving in the current direction.
    float3 boidToTargetVector = target.position - boidInfo.position;
    float targetWeight = dot(boidToTargetVector, boidToTargetVector) > (target.radius * target.radius) ? boidSchoolInfo.targetFollowWeight : 0.0;
    float3 directionTowardsTarget = targetWeight > 0.0 ? normalize(boidToTargetVector) : boidInfo.direction;

    // Calculate the final movement direction vector based on the strength of each vectors.
    float3 newDesiredDirection = 
        cohesionDirection * boidSchoolInfo.cohesionWeight + 
        separationDirection * boidSchoolInfo.separationWeight + 
        alignmentDirection * boidSchoolInfo.alignmentWeight +
        directionTowardsTarget * targetWeight;

    return normalize(newDesiredDirection);
}

// Function checks if the boid is currently outside the simulation area or will it leave the area based on
// current movement direction and speed.
bool WillLeaveSimulationArea(float3 boidPosition, float3 movementDirection, float speed) 
{
    float3 simulationAreaExtents = _SimulationAreaSize * 0.5f;
    float3 minBound = _SimulationAreaCenter - simulationAreaExtents;
    float3 maxBound = _SimulationAreaCenter + simulationAreaExtents;

    // Predicting the new position that the boid will have in one second of simulation if he keeps moving in the same direction.
    float3 newBoidPosition = boidPosition + normalize(movementDirection) * speed * 0.25;
    return any(boidPosition < minBound) || any(boidPosition > maxBound) || any(newBoidPosition < minBound) || any(newBoidPosition > maxBound);
}

// True only when the boid is CURRENTLY, strictly outside the simulation box (not merely predicted to
// leave). Used to drive the entry sprint: freshly spawned off-screen fish read true here and get their
// boost timer refilled + accelerate; fish already inside (even hugging the edge) read false, so normal
// edge behaviour is unchanged.
bool IsStrictlyOutsideBounds(float3 boidPosition)
{
    float3 simulationAreaExtents = _SimulationAreaSize * 0.5f;
    float3 minBound = _SimulationAreaCenter - simulationAreaExtents;
    float3 maxBound = _SimulationAreaCenter + simulationAreaExtents;
    return any(boidPosition < minBound) || any(boidPosition > maxBound);
}

// The main kernel of the compute shader, it updates the position, rotation and movement properties for each
// boid in the simulation based on affecting factors (other boids, obstacles and targets).
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void BoidSimulationKernel (uint3 id : SV_DispatchThreadID)
{
    // Index of the boid in the _Boids array.
    int boidIndex = (int)id.x;

    // Making sure we don't execute excess threads.
    if(boidIndex >= _TotalBoidCount) 
    {
        return;
    }

    // Fetch the information about this boid instance.
    BoidInfo boidInfo = _Boids[boidIndex];
    int rawBoidIdBits = asint(boidInfo.boidID);
    int boidGroupId = rawBoidIdBits & 0xFF;
    BoidSchoolInfo boidSchoolInfo = _BoidSchools[boidGroupId];

    // ---- Affecter response ----------------------------------------------------------------
    // Predator (flee) has priority over Obstacle (casual avoidance):
    //   Predator  -> panic: steer straight away from it AND accelerate to escape.
    //   Obstacle  -> casual: bend the schooling direction to curve around it, no speed-up.
    // -------------------------------------------------------------------------------------------
    bool fleeingPredator = false;
    bool reactingToAffecter = false;   // predator flee OR obstacle avoidance => snap the turn (instant).
                                       // Exit banks smoothly while still INSIDE the bounds (visible),
                                       // then snaps once off-screen so it reliably homes onto the point.
    float3 desiredMovementDirection;

    // ---- Exit response (highest priority) ---------------------------------------------------
    // A school being removed has its target PARKED outside the simulation bounds. Any boid whose
    // matched target is a real Target sitting outside the box is "exiting": it beelines to that
    // target, ignores the return-to-bounds steering below, and accelerates — so it swims out of
    // view before EcosystemSimulationGPU culls it. Normal schools always keep their target inside
    // the box, so they never trigger this.
    Affecter exitTarget = GetClosestAffecter(boidInfo, TARGET_AFFECTER_TYPE);
    bool exiting = (exitTarget.affecterType == TARGET_AFFECTER_TYPE) && IsStrictlyOutsideBounds(exitTarget.position);

    // True once an exiting boid is within _ExitStopDistance of its parked exit point: it has arrived,
    // so it stops dead there instead of overshooting and circling the point (see the speed pass below).
    bool reachedExit = false;

    Affecter closestPredator = GetClosestAffecter(boidInfo, PREDATOR_AFFECTER_TYPE);
    if(exiting)
    {
        // Head to the parked exit target. Do NOT snap (reactingToAffecter stays false): let the
        // normal angular-jerk ramp in UpdateMovementDirection bank the fish smoothly toward the exit
        // instead of whipping around. Speed still sprints — 'exiting' feeds UpdateMovementSpeed below,
        // so the fish accelerates to max speed (via movementJerk) while it turns out.
        float3 toExit = exitTarget.position - boidInfo.position;
        float distToExit = length(toExit);

        // Capture radius must be at least the boid's TURNING CIRCLE (speed / max turn rate): a big,
        // fast fish (shark) physically cannot steer inside a small fixed radius — it would orbit the
        // exit point forever. The 1.2 headroom covers the angular-acceleration ramp. Everything here
        // is off-screen, so stopping a few metres early is invisible.
        // Size this from the SNAP turn rate, not the boid's cruising one: the exit approach sets
        // reactingToAffecter once the boid is off-screen (see below), so it homes on the point at
        // AVOID_TURN_MULTIPLIER times its max angular velocity and can steer far tighter than its normal
        // turning circle. Sizing it from the cruising rate made a slow-turning species claim to have
        // arrived while still tens of metres out — a shark at 22 deg/s stopped 42m short, which can be
        // inside the bounds and in full view — and freeze there.
        float turnRateRadians = radians(max(boidSchoolInfo.maxAngularVelocity, 1.0)) * AVOID_TURN_MULTIPLIER;
        float captureRadius = max(_ExitStopDistance, 1.2 * boidInfo.speed / turnRateRadians);
        if(distToExit <= captureRadius)
        {
            // Arrived: freeze in place (keep the current heading) rather than sail past and loop back.
            reachedExit = true;
            desiredMovementDirection = boidInfo.direction;
        }
        else
        {
            desiredMovementDirection = toExit / distToExit; // normalize (distToExit > 0 here)

            // Once the boid is OFF-SCREEN (strictly outside the bounds), snap the heading straight
            // at the exit point instead of banking. The banked turn's rate is geometry-limited
            // (angular jerk only feeds while angularVelocity < angleTowardTarget), so an agile fish
            // in a ~90-degree orbit sustains far less than its max turn rate and can circle the
            // point forever without ever entering the capture radius. Snapping guarantees a
            // straight-line approach and capture — and nothing out there is visible anyway. Inside
            // the bounds the exit keeps the smooth bank (that part is on-screen).
            if(IsStrictlyOutsideBounds(boidInfo.position))
            {
                reactingToAffecter = true;
            }
        }
    }
    else if(BoidInsideAffecter(closestPredator, boidInfo.position))
    {
        // Flee: hard steer directly away; the speed pass below will accelerate.
        desiredMovementDirection = AffecterAwayDirection(closestPredator, boidInfo.position);
        fleeingPredator = true;
        reactingToAffecter = true;
    }
    else
    {
        // Not fleeing — just the normal schooling direction (kept lazy for performance). Obstacle
        // avoidance is applied below to EVERY steering state, not only here.
        desiredMovementDirection = CalculateSchoolBehaviourDirection(boidIndex, boidSchoolInfo, boidInfo);
    }

    // Check if the desired direction will lead to leaving the simulation bounds.
    // If so, offset the movement direction towards the center of the simulation area.
    // Exiting boids are ALLOWED to leave — only non-exiting boids get pulled back inside.
    if(!exiting && WillLeaveSimulationArea(boidInfo.position, desiredMovementDirection, boidInfo.speed))
    {
        desiredMovementDirection = normalize(_SimulationAreaCenter - boidInfo.position);

        // Returning to bounds is not a flee — don't accelerate for it.
        fleeingPredator = false;
    }

    // ---- Obstacle avoidance (applies to EVERY steering state above) ----------------------------
    // Rocks / coral must be dodged whether the fish is schooling, sprinting IN from its spawn point,
    // being pulled back into bounds, or swimming OUT to an exit point — so this runs AFTER all of those
    // have set the heading, blending an away-vector into it. It fires a little before the surface (not
    // only once inside) so a fast fish still has room to bank clear. A stopped, arrived exit fish is
    // left alone (it is about to be culled).
    // The closest obstacle is still needed for the hard penetration backstop at the bottom of the kernel,
    // but NOT for the steering — see AccumulateObstacleAvoidance for why steering off a single "closest"
    // obstacle produces a discontinuous escape direction.
    Affecter closestObstacle = GetClosestAffecter(boidInfo, OBSTACLE_AFFECTER_TYPE);
    bool hasObstacle = closestObstacle.affecterType == OBSTACLE_AFFECTER_TYPE;
    if(!reachedExit && (_ReefSDFEnabled != 0 || hasObstacle))
    {
        // How close this SPECIES lets the reef get before it starts bending away, from its authored
        // FishSchoolProperties.ObstacleAvoidanceRange. Per-species because it must stay above the boid's
        // own turning circle (speed / max angular velocity) or it physically cannot turn clear in time —
        // and because a bottom-dweller needs a small one to hug the substrate while a shark needs a wide
        // berth. Guarded to a sane minimum so a species authored at 0 does not divide by zero below.
        float obstacleAvoidMargin = max(sqrt(boidSchoolInfo.obstacleAvoidanceRangeSquared), 0.01);

        // Escape direction and how close the reef is. Prefer the baked distance field: it describes the
        // REAL rock surface, and both the distance and the direction are continuous, so there is no
        // "closest obstacle" that can change between frames and teleport the escape heading. Fall back to
        // the old proximity-weighted blend over box affecters when no field is baked.
        float obstacleProximity;
        float3 accumulatedAway;
        if(_ReefSDFEnabled != 0)
        {
            float reefDistance = SampleReefDistance(boidInfo.position);
            if(reefDistance > obstacleAvoidMargin)
            {
                accumulatedAway = float3(0.0, 0.0, 0.0);
                obstacleProximity = 0.0;
            }
            else
            {
                obstacleProximity = saturate(1.0 - reefDistance / obstacleAvoidMargin);
                obstacleProximity *= obstacleProximity;
                // The gradient points away from the nearest surface. Its LENGTH is the confidence: the
                // field is unsigned, so right at a surface voxel the distance bottoms out at 0 and the
                // gradient collapses, carrying no direction. Treat that as "no steer" and let the
                // penetration backstop below deal with it.
                float3 gradient = ReefSDFGradientRaw(boidInfo.position);
                accumulatedAway = dot(gradient, gradient) > 1e-8 ? normalize(gradient) * obstacleProximity
                                                                : float3(0.0, 0.0, 0.0);
            }
        }
        else
        {
            accumulatedAway = AccumulateObstacleAvoidance(boidInfo, obstacleAvoidMargin, obstacleProximity);
        }

        if(dot(accumulatedAway, accumulatedAway) > 1e-6)
        {
            float3 awayDirection = normalize(accumulatedAway);

            // Bottom-dwellers steer AROUND reef structure instead of over it. The deflection below turns
            // the heading until it is tangential to the escape vector, and in free 3D the closest tangent
            // to a level heading tilts UPWARD — geometrically the shortest way clear ("go over it"), and
            // right for most fish. But near the substrate every escape vector carries an upward component,
            // so a ray went over each rock it met and climbed a little each time, until it was at the
            // surface. Flattening the escape vector keeps the tangent in the horizontal plane, so it banks
            // around instead. See FishSchoolProperties.HorizontalAvoidBias.
            float horizontalBias = saturate(boidSchoolInfo.horizontalAvoidBias);
            if(horizontalBias > 0.0)
            {
                float3 flattened = float3(awayDirection.x,
                                          awayDirection.y * (1.0 - horizontalBias),
                                          awayDirection.z);
                // Guard: an obstacle directly above or below leaves nothing horizontal to steer around.
                // Keep the true 3D vector there, so a head-on dive into the seabed is still avoided.
                if(dot(flattened, flattened) > 1e-4)
                {
                    awayDirection = normalize(flattened);
                }
            }

            // Steer AROUND the obstacle rather than away from it.
            //
            // Cancelling exactly the component of the heading that points INTO the surface leaves a
            // heading TANGENTIAL to it, so the fish banks around the rock in a smooth arc, still going
            // roughly where it wanted to. The old code instead added the away-vector radially at
            // OBSTACLE_AVOID_STRENGTH times the heading's own weight, which told a fish swimming at a
            // rock to head straight back the way it came — a ~180 degree reversal that it then executed
            // at up to its full angular velocity. That was the unnatural jerk.
            //
            // The deflection is capped AT the tangent and never past it, so avoidance can only ever slide
            // a fish along an obstacle, never bounce it backwards. Clearance comes from the margin
            // instead: the fish starts arcing well before it arrives. Tunnelling is still backstopped by
            // ResolveObstaclePenetration below.
            float inwardAmount = -dot(desiredMovementDirection, awayDirection); // > 0 => heading into it
            if(inwardAmount > 0.0)
            {
                // OBSTACLE_AVOID_STRENGTH now sets how fast the deflection reaches full tangent as the
                // fish closes in, rather than how hard it is shoved. saturate() is the cap at tangent.
                float deflect = saturate(obstacleProximity * OBSTACLE_AVOID_STRENGTH) * inwardAmount;
                float3 steered = desiredMovementDirection + awayDirection * deflect;

                // A dead-on approach cancels to a zero vector — no tangent is implied, since both ways
                // round are equally good. Pick one deterministically so the fish commits to a side
                // instead of stalling on a degenerate direction.
                if(dot(steered, steered) < 1e-4)
                {
                    float3 side = cross(awayDirection, float3(0.0, 1.0, 0.0));
                    if(dot(side, side) < 1e-6) side = cross(awayDirection, float3(1.0, 0.0, 0.0));
                    steered = side;
                }
                desiredMovementDirection = normalize(steered);
            }

            // Deliberately DO NOT set reactingToAffecter here. Obstacle avoidance steers with the boid's
            // normal angular ramp so it banks smoothly around the rock/coral (a casual curve, not a panic
            // jerk). Only predator flee / off-screen exit snap-turn. The hard ResolveObstaclePenetration
            // pass below still guarantees the fish can never tunnel through, snap or no snap.
        }
    }

    // ---- Entry sprint --------------------------------------------------------------------------
    // Freshly spawned fish appear OUTSIDE the box (off-screen) and rush in. entryBoostTimeRemaining
    // carries the entry state, armed ONCE by the spawner (see BoidSpawnerGPU.SpawnBoids):
    //   < 0  : spawned at an off-screen entry point, has not crossed into the bounds yet => sprint.
    //   > 0  : has crossed in; burning off the post-entry momentum, counting down to 0.
    //   == 0 : entry finished, or the fish spawned inside the box to begin with => never sprints.
    // Only a boid still in the "< 0" state reacts to being outside the box. This used to refill the
    // timer for ANY boid found outside, which meant a settled fish that drifted over the boundary was
    // mistaken for a new arrival and sprinted at MaxSpeed; it then overshot out the far side, re-armed
    // itself, and pinballed across the box indefinitely instead of ever settling to cruising speed.
    bool outsideBounds = IsStrictlyOutsideBounds(boidInfo.position);
    bool entrySprint;
    if(boidInfo.entryBoostTimeRemaining < 0.0)
    {
        // Still on the way in. The frame it crosses the boundary, start the post-entry countdown —
        // which may be 0, meaning "settle to cruising speed the instant it enters".
        if(!outsideBounds)
        {
            boidInfo.entryBoostTimeRemaining = _EntryBoostDuration;
        }
        entrySprint = true;
    }
    else if(boidInfo.entryBoostTimeRemaining > 0.0)
    {
        boidInfo.entryBoostTimeRemaining = max(0.0, boidInfo.entryBoostTimeRemaining - _TimeDelta);
        entrySprint = true;
    }
    else
    {
        entrySprint = false;
    }

    // Steer the boid toward the desired movement direction (snapping instantly when reacting to an affecter).
    UpdateMovementDirection(desiredMovementDirection, boidSchoolInfo, boidInfo, reactingToAffecter);

    if(reachedExit)
    {
        // Reached the exit point: stop dead and hold here (no cruising-speed floor) so the fish doesn't
        // overshoot and circle. It waits, motionless, the moment or two until the school is culled.
        boidInfo.speed = 0.0;
        boidInfo.acceleration = 0.0;
    }
    else
    {
        // A predator flee, an entry sprint OR an exit sprint accelerates the boid; casual obstacle
        // avoidance keeps normal speed.
        UpdateMovementSpeed(fleeingPredator || entrySprint || exiting, boidSchoolInfo, boidInfo);
    }

    // After the movement properties have been updated, update the current position of the boid.
    UpdatePosition(boidInfo);

    // Hard guarantee: if the frame's movement still landed this boid in the reef (steering can be outrun
    // by a sprinting entry/exit fish, or a school push can shove one in), get it back out.
    // Skip the reef backstop for a path-following moray. MorayCaveDirector suppresses the moray's obstacle
    // avoidance range to ~0 while it heads into a cave; when it is, let it follow its authored path STRAIGHT
    // into the reef and clip slightly, instead of being shoved back out (which read as it still "avoiding"
    // obstacles and straying off the path). A roaming moray keeps its normal avoidance range, so it still
    // gets the backstop, as does every other fish.
    bool morayClipping = (boidGroupId == _MorayGroupId) && (boidSchoolInfo.obstacleAvoidanceRangeSquared < 0.02);
    if(_ReefSDFEnabled != 0)
    {
        if(!morayClipping) ResolveReefPenetration(boidInfo, boidSchoolInfo);
    }
    else if(hasObstacle && !morayClipping)
    {
        ResolveObstaclePenetration(closestObstacle, boidInfo, boidSchoolInfo);
    }

    // Update the swimming motion properties based on the current acceleration. These properties affect
    // the movement motion that the rendering shader will visualize.
    UpdateSwimMotionIntensity(boidSchoolInfo, boidInfo);

    // Based on the swimming motion intensity, update the current time that drives the swimming movement motion.
    // Basically this is the time that is passed into sine functions to offset the vertices in the vertex shsader.
    UpdateSwimMotionTime(boidInfo);

    // ---- Moray cave freeze ---------------------------------------------------------------------
    // Ease a moray onto its cave anchor by the director-ramped weight so it swims the last stretch in
    // and stops. Runs on the FINAL post-physics position, before the trail append so the trail records
    // the settled position. w=1 => position is the anchor every frame (pinned). Non-destructive: leaves
    // speed/direction alone, so when the weight drops (leaving / removed) the boid simply swims off again.
    if (_MorayGroupId >= 0 && boidGroupId == _MorayGroupId && _MorayRestAnchorCount > 0)
    {
        float bestDist = _MorayRestMatchRadius;
        float w = 0.0;
        float3 anchorPos = boidInfo.position;
        int rc = min(_MorayRestAnchorCount, MORAY_MAX_REST_ANCHORS);
        for (int ri = 0; ri < rc; ri++)
        {
            float3 ap = _MorayRestAnchorPos[ri].xyz;
            float  d  = distance(boidInfo.position, ap);
            if (d < bestDist) { bestDist = d; w = saturate(_MorayRestAnchorPos[ri].w); anchorPos = ap; }
        }
        if (w > 0.0) boidInfo.position = lerp(boidInfo.position, anchorPos, w);
    }

    // ---- Moray trail append --------------------------------------------------------------------
    // Record this moray's HEAD path so its render shader can trail the body along it. Fixed-distance
    // append: push a new sample only once the head has moved _MorayTrailSpacing since the last one, so
    // K samples always span the same arclength (K * spacing metres) whatever the swim speed — a slow
    // moray rests in a held S-curve, a fast one stretches out, both correct. Uses the FINAL position
    // (after UpdatePosition + the penetration backstop). ring[cursor] is always the newest sample.
    if (_MorayGroupId >= 0 && boidGroupId == _MorayGroupId)
    {
        int morayLocal = (int)boidInfo.originalIndex - _MorayBufferOffset;
        if (morayLocal >= 0 && morayLocal < _MorayCount)
        {
            int morayBase   = morayLocal * _MorayTrailCount;
            int cursor      = _MorayTrailCursor[morayLocal];
            float3 lastSample = _MorayTrail[morayBase + cursor].xyz;
            float3 delta      = boidInfo.position - lastSample;
            if (dot(delta, delta) >= _MorayTrailSpacing * _MorayTrailSpacing)
            {
                int next = cursor + 1;
                if (next >= _MorayTrailCount) next = 0;
                _MorayTrail[morayBase + next] = float4(boidInfo.position, 1.0);
                _MorayTrailCursor[morayLocal] = next;
            }
        }
    }

    // Write the updated boid info into the output boids buffer at the original position of the boid. We need to
    // write to the original position since the rendering shader uses those original positions to render correct meshes.
    _BoidsOutput[boidInfo.originalIndex] = boidInfo;
}
