#pragma kernel BoidSimulationKernel
#define THREAD_GROUP_SIZE 256
#define TARGET_AFFECTER_TYPE 0.0
#define OBSTACLE_AFFECTER_TYPE 1.0
#define PREDATOR_AFFECTER_TYPE 2.0
#define AFFECTS_ALL 255
#define SHAPE_SPHERE 0.5   // shape < 0.5 => sphere, else box
// How strongly an obstacle bends the boid's schooling direction the moment it enters the zone.
// This weights the away-vector against the school heading: higher = the away direction dominates,
// so the fish turns out hard and immediately (a snappy "jerk away") while still keeping a touch of
// school coherence. It is a STEERING weight only — it never speeds the fish up (still casual, no
// acceleration; that is reserved for Predator). Bump higher for an even harder turn.
#define OBSTACLE_AVOID_STRENGTH 6.0

// When reacting to an affecter (predator flee OR obstacle avoidance) the boid SKIPS the slow
// angular-velocity ramp and turns at this multiple of its max angular velocity, so it snaps toward
// the escape heading the frame it enters the zone instead of easing in over ~a second. This is a
// TURN-RATE boost only — it does not change linear speed. Raise for an even snappier reaction.
#define AVOID_TURN_MULTIPLIER 8.0

#include "Assets/Junheng/Shaders/Compute/BoidSimulationData.hlsl"
#include "Assets/Junheng/Shaders/Compute/Quaternion.hlsl"
#include "Assets/Junheng/Shaders/Compute/GPU_Grid_Spatial_Partition/SpatialPartitionUtils.hlsl"

// General simulation properties.
int _TotalBoidCount;
int _TotalAffectersCount;
float _TimeDelta;
float3 _SimulationAreaCenter;
float3 _SimulationAreaSize;

// Buffer containing all boids in the simulation.
StructuredBuffer<BoidInfo> _Boids;
RWStructuredBuffer<BoidInfo> _BoidsOutput;
// Buffer containing offset for each cell in the spatial partition based on 
// the total number of boids in cells before. 
StructuredBuffer<uint> _CellsOffsetsBuffer;
// Buffer containing informations about every boid school used in the simulation.
StructuredBuffer<BoidSchoolInfo> _BoidSchools;
// Buffer containing all obstacles and targets of the simulation that
// can affect the behavior of the boids.
StructuredBuffer<Affecter> _Affecters;

float InverseLerp(float minValue, float maxValue, float value)
{
    return (value - minValue) / (maxValue - minValue);
}

// -------------------------------------------------------------------------
// Affecter shape helpers — an affecter's influence volume is either a sphere
// (radius) or an oriented box (halfExtents + rotation). These give one
// surface-distance / inside test / away-direction that works for both shapes.
// -------------------------------------------------------------------------

// Brings a world position into the affecter's local (box) space using the
// inverse (conjugate) of the box rotation. For a unit quaternion the conjugate
// is the inverse, so this un-rotates the world offset into axis-aligned space.
float3 AffecterLocalPosition(Affecter affecter, float3 worldPosition)
{
    float4 inverseRotation = float4(-affecter.rotation.xyz, affecter.rotation.w);
    return Multiply(InitializeQuaternion(inverseRotation), worldPosition - affecter.position);
}

// Distance from a boid to the affecter's influence surface. 0 when inside.
float AffecterSurfaceDistance(Affecter affecter, float3 boidPosition)
{
    if(affecter.shape < SHAPE_SPHERE)
    {
        return max(0.0, length(affecter.position - boidPosition) - affecter.radius);
    }
    float3 delta = abs(AffecterLocalPosition(affecter, boidPosition)) - affecter.halfExtents;
    return length(max(delta, 0.0));
}

// Is the boid inside the affecter's influence volume?
bool BoidInsideAffecter(Affecter affecter, float3 boidPosition)
{
    if(affecter.shape < SHAPE_SPHERE)
    {
        return length(affecter.position - boidPosition) <= affecter.radius;
    }
    float3 local = AffecterLocalPosition(affecter, boidPosition);
    return all(abs(local) <= affecter.halfExtents);
}

// World-space direction pointing away from the affecter centre (used to steer clear).
float3 AffecterAwayDirection(Affecter affecter, float3 boidPosition)
{
    float3 awayVector = boidPosition - affecter.position;
    float lengthSquared = dot(awayVector, awayVector);
    return lengthSquared > 1e-6 ? awayVector * rsqrt(lengthSquared) : float3(0.0, 1.0, 0.0);
}

// Function returns the closest affecter of the specified affecter type to the current boid.
// If no affecter of that type exists, returns a harmless "null" affecter (Sphere, radius -1)
// so that BoidInsideAffecter() / distance tests always report "not affected" instead of
// reading an uninitialized struct (which could make boids flee/avoid nothing at random).
Affecter GetClosestAffecter(BoidInfo boidInfo, float affecterType)
{
    // Initial variables — closestAffecter defaults to a no-op sphere with negative radius.
    Affecter closestAffecter = (Affecter)0;
    closestAffecter.radius = -1.0;                 // negative radius => never "inside"
    closestAffecter.halfExtents = float3(-1, -1, -1);
    closestAffecter.shape = 0.0;                    // sphere path (uses the negative radius)
    closestAffecter.rotation = float4(0, 0, 0, 1); // identity, just in case
    closestAffecter.affecterType = -1.0;
    float closestAffecterDistance = -1;

    int rawBoidIdBits = asint(boidInfo.boidID);
    int boidId = rawBoidIdBits & 0xFF;
    int boidSubGroupId = (rawBoidIdBits >> 8) & 0xFF;

    // Go through all affecters and find the one closest to the provided boid position.
    for(int i = 0; i < _TotalAffectersCount; i++)
    {
        // Fetch the affecter and check its type. If its type is not the one we're focues on,
        // just skip over it. 
        Affecter affecter = _Affecters[i];
        if(affecter.affecterType != affecterType)
        {
            continue;
        }

        // If the affecter doesn't affect this boid group, skip it.
        // Also, if the affecter targets specific sub-group inside the boid group, check that as well.
        int affecterGroupId = (int)affecter.boidGroupId;
        int affecterSubGroupId = (int)affecter.boidSubGroupId;
        if((affecterGroupId != AFFECTS_ALL && boidId != affecterGroupId) || 
           (affecterSubGroupId != AFFECTS_ALL && boidSubGroupId != affecterSubGroupId)) 
        {
            continue;
        }

        // Get the distance between the boid and the affecter (shape-aware: sphere or box) and
        // cache the affecter if it's the closest one. Or if there isn't a closest
        // affecter initialized yet.
        float distanceFromAffecter = AffecterSurfaceDistance(affecter, boidInfo.position);
        if(closestAffecterDistance < 0.0 || distanceFromAffecter < closestAffecterDistance) {
            closestAffecterDistance = distanceFromAffecter;
            closestAffecter = affecter;
        }
    }

    // Return the closest affecter to the boid position.
    return closestAffecter;
}

// Update the swim motion time based on the current swimming motion intensity. This time is used by the rendering shader
// to correctly visualize the swimming motion pattern of this boid.
void UpdateSwimMotionTime(inout BoidInfo boidInfo) 
{
    float swimPlaybackSpeed = lerp(boidInfo.minPlaybackSpeed, boidInfo.maxPlaybackSpeed, boidInfo.swimMotionIntensity);
    boidInfo.currentSwimTime += _TimeDelta * swimPlaybackSpeed;
}

// Update the swim motion intensity of the boid based on the current total acceleration. NOTE: The swim intensity
// is guided by acceleration, not velocity!
void UpdateSwimMotionIntensity(BoidSchoolInfo boidSchoolInfo, inout BoidInfo boidInfo)
{
    float movementIntensity = InverseLerp(0.0, boidSchoolInfo.maxAcceleration, boidInfo.acceleration);
    float rotationIntensity = InverseLerp(0.0, boidSchoolInfo.maxAngularAcceleration, boidInfo.angularAcceleration);
    boidInfo.swimMotionIntensity = saturate(max(movementIntensity, rotationIntensity));
}

// Update the current position of the boid based on the current movement direction, speed and time passed.
void UpdatePosition(inout BoidInfo boidInfo)
{
    float3 newPosition = boidInfo.position + boidInfo.direction * _TimeDelta * boidInfo.speed;
    boidInfo.position = newPosition;
}

// Function updates the movement speed and acceleration of the boid based on its need to accelerate this frame or not.
void UpdateMovementSpeed(bool shouldAccelerate, BoidSchoolInfo boidSchoolInfo, inout BoidInfo boidInfo)
{
    // If the boid should accelerate, adde the increase the movement jerk (rate of change in acceleration).
    float currentJerk = shouldAccelerate ? boidSchoolInfo.movementJerk : 0.0;
    float deceleration = currentJerk > 0.0 ? 0.0 : boidSchoolInfo.deceleration;
    // Update the current acceleration and speed.
    float currentAcceleration = clamp(boidInfo.acceleration + (currentJerk - deceleration) * _TimeDelta, 0.0, boidSchoolInfo.maxAcceleration);
    float currentMovementSpeed = boidInfo.speed;

    // If the current speed will be lower than the cruising speed that the boid is constantly trying to maintain, increase
    // the acceleration to correct the movement speed to the desired cruising speed.
    if((currentMovementSpeed + (currentAcceleration - boidSchoolInfo.waterFriction * currentMovementSpeed) * _TimeDelta) < boidSchoolInfo.cruisingSpeed) 
    {
        currentAcceleration = boidSchoolInfo.cruisingSpeed * boidSchoolInfo.waterFriction;
    }

    // Update the current movement speed and clamp its value between the desired range.
    currentMovementSpeed += (currentAcceleration - boidSchoolInfo.waterFriction * currentMovementSpeed) * _TimeDelta;
    currentMovementSpeed = clamp(currentMovementSpeed, boidSchoolInfo.cruisingSpeed, boidSchoolInfo.maxSpeed);

    // Update the boid movement properties.
    boidInfo.acceleration = currentAcceleration;
    boidInfo.speed = currentMovementSpeed;
}

// Function updates the current movement direction of the boid toward the target direction it would like to move
// based on the current angular acceleration and movement speed.
void UpdateMovementDirection(float3 targetDirection, BoidSchoolInfo boidSchoolInfo, inout BoidInfo boidInfo, bool snapTurn)
{
    // Calculate the angle that the fish would need to steer in order to face the desired movement direction.
    quaternion rotationTowardTarget = LookRotation(targetDirection, float3(0, 1, 0));
    quaternion currentRotation = LookRotation(boidInfo.direction, float3(0, 1, 0));
    float angleTowardTarget = Angle(currentRotation, rotationTowardTarget);

    // Based on the angle the fish needs to steer, check if we need to increase the angular acceleration or not.
    // Using 50 degrees as an angle threshold for starting to speed up at maximum acceleration.
    float currentAngularJerk = boidInfo.angularVelocity < angleTowardTarget ? lerp(0.0, boidSchoolInfo.angularJerk, (angleTowardTarget - boidInfo.angularVelocity) / 50.0) : 0.0;
    float angularDeceleration = currentAngularJerk > 0.0 ? 0.0 : boidSchoolInfo.angularDeceleration;
    // Update the current angular acceleration and speed.
    float currentAngularAcceleration = clamp(boidInfo.angularAcceleration + (currentAngularJerk - angularDeceleration) * _TimeDelta, 0.0, boidSchoolInfo.maxAngularAcceleration);
    float currentAngularVelocity = clamp(boidInfo.angularVelocity + currentAngularAcceleration * _TimeDelta, 0.0, boidSchoolInfo.maxAngularVelocity);

    // Affecter reaction snap: bypass the ramp entirely — turn at a high multiple of max angular
    // velocity and apply the rotation fully — so the boid whips toward the escape heading the frame
    // it enters the zone. Turn-rate only; linear speed is handled separately (no speed-up here).
    float appliedAngularVelocity = snapTurn ? boidSchoolInfo.maxAngularVelocity * AVOID_TURN_MULTIPLIER : currentAngularVelocity;
    float rotationSmoothing = snapTurn ? 1.0 : 0.85;

    // Rotate the direction toward the desired one based on the (possibly boosted) angular velocity.
    quaternion newRotation = RotateTowards(currentRotation, rotationTowardTarget, appliedAngularVelocity * _TimeDelta);
    // Smooth the rotation based on the previous one, to produce smoother movement (full apply when snapping).
    newRotation = Slerp(currentRotation, newRotation, rotationSmoothing);

    // Keep angular velocity primed while snapping so the reaction stays instant across the whole zone.
    if(snapTurn)
    {
        currentAngularVelocity = boidSchoolInfo.maxAngularVelocity;
    }

    // If we haven't increased the angular acceleration this frame, this means that the angular velocity should slowly deteriorate.
    if(currentAngularJerk <= 0.0)
    {
        currentAngularVelocity = clamp(currentAngularVelocity - boidSchoolInfo.angularVelocityReduction * _TimeDelta, 0.0, boidSchoolInfo.maxAngularVelocity);
    }

    // Update the current movement acceleration based on the percentage of the angular acceleration for this frame. 
    // This is due to translation of movement energy released while swimming to rotate.
    float currentAcceleration = boidInfo.acceleration + currentAngularAcceleration * boidSchoolInfo.rotationEffectOnSpeed * _TimeDelta;

    // Calculate the current movement direction based on the current rotation.
    float3 currentMovementDirection = Multiply(newRotation, float3(0, 0, 1));

    // Update boid movement properties that were changed during these direction updates.
    boidInfo.acceleration = currentAcceleration;
    boidInfo.direction = currentMovementDirection;
    boidInfo.angularVelocity = currentAngularVelocity;
    boidInfo.angularAcceleration = currentAngularAcceleration;
}

// Function calculates the separation vector of the boid that will steer it away from the neighboring boid.
// The closer the boids are, the stronger the separation vector.
float3 GetSeparationVector(float3 boidPosition, float3 neighborPosition, float inverseSeparationRangeSquared)
{
    float3 vectorAwayFromNeighbor = boidPosition - neighborPosition;
    float distanceSquared = dot(vectorAwayFromNeighbor, vectorAwayFromNeighbor);

    return vectorAwayFromNeighbor * saturate(1.0 - distanceSquared * inverseSeparationRangeSquared);
}

// Function calculates the new desired movement direction of the boid based on its neighboring boids and the 
// closest target that the boid is trying to reach. The neighboring boids affect the movement since the 
// boid is trying to move in the same direction as them, while keeping a safe distance from each boid in the group.
float3 CalculateSchoolBehaviourDirection(int boidIndex, BoidSchoolInfo boidSchoolInfo, inout BoidInfo boidInfo) 
{
    // Initialize parameters for behavior.
    float3 separation = float3(0,0,0);
    float3 alignmentDirection = boidInfo.direction;
    float3 cohesionPosition = boidInfo.position;
    
    // Find the closest target to this boid, this is the target that this boid will try to reach.
    Affecter target = GetClosestAffecter(boidInfo, TARGET_AFFECTER_TYPE);
    
    // Caching the inverse of the separation range so that we could use multiplication instead of division
    // when calculating the separation intensity of each neighboring boid.
    float inverseSeparationRangeSquared = 1.0 / boidSchoolInfo.separationRangeSquared;

    // Get ID of the cell that this boid belons to.
    uint cellID = GetCellID(boidInfo.position);
    uint cellOffsetY = _CellCountX;
    uint cellOffsetZ = _CellCountX * _CellCountZ;

    // Initialize helper variables for averaging directions and their strength.
    int neighborsCount = 0;
    int separationNeighborsCount = 0;

    // Get the Boid group ID of this boid.
    int thisBoidId = asint(boidInfo.boidID) & 0xFF;
    int thisBoidSubGroupId = (asint(boidInfo.boidID) >> 8) & 0xFF; 

    // For each neighboring cell, of the one that the boid is currently located in, check the distance of neighboring
    // boids and update the cohesion, alignment and separation vectors.
    for(uint cellIndexZ = cellID - cellOffsetZ; cellIndexZ <= cellID + cellOffsetZ; cellIndexZ += cellOffsetZ)
    {
        for(uint cellIndexY = cellIndexZ - cellOffsetY; cellIndexY <= cellIndexZ + cellOffsetY; cellIndexY += cellOffsetY)
        {
            // Indices of the first and the last neighboring cell that we're interested in. Make sure to clamp
            // the indices between the total number of cells.
            uint firstCellIndex = max(0, cellIndexY - 1);
            uint lastCellIndex = min(_TotalCellCount - 1, cellIndexY + 1);

            // Since each cell contains the total number of boids in that cell and all other cells before it, we can 
            // use that value of one cell before to get an index of the first boid of the desired cell. Of course,
            // if the current cell is the first one, the first index is 0 since there is no cell before this one.
            uint startBoidIndex = firstCellIndex == 0 ? 0 : _CellsOffsetsBuffer[firstCellIndex - 1];
            uint endBoidIndex = _CellsOffsetsBuffer[lastCellIndex];

            // For each boid located in those cells, calculate the cohesion, separation and alignment vectors.
            for(uint i = startBoidIndex; i < endBoidIndex; i++) {
                // The boid shouldn't affect itself.
                if(i == (uint)boidIndex) 
                {
                    continue;
                }

                BoidInfo otherBoidInfo = _Boids[i];
                int otherBoidID = asint(otherBoidInfo.boidID) & 0xFF;
                // If the boid is a smaller fish species, it shouldn't affect our behaviour.
                if(otherBoidID < thisBoidId)
                {
                    continue;
                }

                // Check the distance to the other boid and see if its outside our vision distance. This is the distance
                // each boid uses as a "sensing distance" to feel the presence of other boids.
                float3 boidToOtherBoidVector = (otherBoidInfo.position - boidInfo.position);
                float distanceSquared = dot(boidToOtherBoidVector, boidToOtherBoidVector);
                if(distanceSquared > boidSchoolInfo.visionRangeSquared || distanceSquared <= 0.0) 
                {
                    continue;
                }

                // If the neighboring boid is very cloe to us, check if we should start separating from it or not.
                if(distanceSquared < boidSchoolInfo.separationRangeSquared)
                {
                    separation += GetSeparationVector(boidInfo.position, otherBoidInfo.position, inverseSeparationRangeSquared);
                    separationNeighborsCount++;
                }

                // Only calculating cohesion and alignment with the same fish species and the same sub-group inside the fish species. 
                // Note that the separation was calculated based on the same species as well as for all larger fish.
                int otherBoidSubGroupId = (asint(otherBoidInfo.boidID) >> 8) & 0xFF; 
                if(otherBoidID != thisBoidId || otherBoidSubGroupId != thisBoidSubGroupId) 
                {
                    continue;
                }

                // Updating alignment and cohesion vectors.
                alignmentDirection += otherBoidInfo.direction;
                cohesionPosition += otherBoidInfo.position;
                neighborsCount++;
            }
        }
    }

    // Average the alignment direction and cohesion position based on the total number of neighboring boids that were affecting this one.
    float averagingFactor = neighborsCount == 0 ? 1.0 : 1.0 / neighborsCount;
    alignmentDirection *= averagingFactor;
    cohesionPosition *= averagingFactor;

    // Average the separation direction.
    if(separationNeighborsCount > 0) {
        separation /= separationNeighborsCount;
    }

    // If there were no neighbors affecting this boid, the cohesion will be the current direction of movement.
    float3 cohesionDirection = neighborsCount == 0 ? boidInfo.direction : normalize(cohesionPosition - boidInfo.position);

    // Scale the separation vector based on the distance from the closest neighbor.
    float separationSquaredLength = dot(separation, separation);
    float3 separationDirection = separationNeighborsCount > 0 && separationSquaredLength > 0 ? normalize(separation) : boidInfo.direction;

    // Check if the boid has already reached the "reaching" distance from the target. If so, just continue moving in the current direction.
    float3 boidToTargetVector = target.position - boidInfo.position;
    float targetWeight = dot(boidToTargetVector, boidToTargetVector) > (target.radius * target.radius) ? boidSchoolInfo.targetFollowWeight : 0.0;
    float3 directionTowardsTarget = targetWeight > 0.0 ? normalize(boidToTargetVector) : boidInfo.direction;

    // Calculate the final movement direction vector based on the strength of each vectors.
    float3 newDesiredDirection = 
        cohesionDirection * boidSchoolInfo.cohesionWeight + 
        separationDirection * boidSchoolInfo.separationWeight + 
        alignmentDirection * boidSchoolInfo.alignmentWeight +
        directionTowardsTarget * targetWeight;

    return normalize(newDesiredDirection);
}

// Function checks if the boid is currently outside the simulation area or will it leave the area based on
// current movement direction and speed.
bool WillLeaveSimulationArea(float3 boidPosition, float3 movementDirection, float speed) 
{
    float3 simulationAreaExtents = _SimulationAreaSize * 0.5f;
    float3 minBound = _SimulationAreaCenter - simulationAreaExtents;
    float3 maxBound = _SimulationAreaCenter + simulationAreaExtents;

    // Predicting the new position that the boid will have in one second of simulation if he keeps moving in the same direction.
    float3 newBoidPosition = boidPosition + normalize(movementDirection) * speed * 0.25;
    return any(boidPosition < minBound) || any(boidPosition > maxBound) || any(newBoidPosition < minBound) || any(newBoidPosition > maxBound);
}

// The main kernel of the compute shader, it updates the position, rotation and movement properties for each
// boid in the simulation based on affecting factors (other boids, obstacles and targets).
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void BoidSimulationKernel (uint3 id : SV_DispatchThreadID)
{
    // Index of the boid in the _Boids array.
    int boidIndex = (int)id.x;

    // Making sure we don't execute excess threads.
    if(boidIndex >= _TotalBoidCount) 
    {
        return;
    }

    // Fetch the information about this boid instance.
    BoidInfo boidInfo = _Boids[boidIndex];
    int rawBoidIdBits = asint(boidInfo.boidID);
    int boidGroupId = rawBoidIdBits & 0xFF;
    BoidSchoolInfo boidSchoolInfo = _BoidSchools[boidGroupId];

    // ---- Affecter response ----------------------------------------------------------------
    // Predator (flee) has priority over Obstacle (casual avoidance):
    //   Predator  -> panic: steer straight away from it AND accelerate to escape.
    //   Obstacle  -> casual: bend the schooling direction to curve around it, no speed-up.
    // -------------------------------------------------------------------------------------------
    bool fleeingPredator = false;
    bool reactingToAffecter = false;   // predator flee OR obstacle avoidance => snap the turn (instant)
    float3 desiredMovementDirection;

    Affecter closestPredator = GetClosestAffecter(boidInfo, PREDATOR_AFFECTER_TYPE);
    if(BoidInsideAffecter(closestPredator, boidInfo.position))
    {
        // Flee: hard steer directly away; the speed pass below will accelerate.
        desiredMovementDirection = AffecterAwayDirection(closestPredator, boidInfo.position);
        fleeingPredator = true;
        reactingToAffecter = true;
    }
    else
    {
        // Not fleeing — compute the normal schooling direction (kept lazy for performance).
        float3 schoolDirection = CalculateSchoolBehaviourDirection(boidIndex, boidSchoolInfo, boidInfo);

        Affecter closestObstacle = GetClosestAffecter(boidInfo, OBSTACLE_AFFECTER_TYPE);
        if(BoidInsideAffecter(closestObstacle, boidInfo.position))
        {
            // Casual avoidance: blend an away-vector into the school heading so the fish curves
            // around the obstacle without abandoning the school or panicking (no speed-up), and
            // snap the turn so it reacts the moment it enters the zone.
            float3 awayDirection = AffecterAwayDirection(closestObstacle, boidInfo.position);
            desiredMovementDirection = normalize(schoolDirection + awayDirection * OBSTACLE_AVOID_STRENGTH);
            reactingToAffecter = true;
        }
        else
        {
            desiredMovementDirection = schoolDirection;
        }
    }

    // Check if the desired direction will lead to leaving the simulation bounds.
    // If so, offset the movement direction towards the center of the simulation area.
    if(WillLeaveSimulationArea(boidInfo.position, desiredMovementDirection, boidInfo.speed))
    {
        desiredMovementDirection = normalize(_SimulationAreaCenter - boidInfo.position);

        // Returning to bounds is not a flee — don't accelerate for it.
        fleeingPredator = false;
    }

    // Steer the boid toward the desired movement direction (snapping instantly when reacting to an affecter).
    UpdateMovementDirection(desiredMovementDirection, boidSchoolInfo, boidInfo, reactingToAffecter);

    // Only a predator flee accelerates the boid; casual obstacle avoidance keeps normal speed.
    UpdateMovementSpeed(fleeingPredator, boidSchoolInfo, boidInfo);

    // After the movement properties have been updated, update the current position of the boid.
    UpdatePosition(boidInfo);

    // Update the swimming motion properties based on the current acceleration. These properties affect
    // the movement motion that the rendering shader will visualize.
    UpdateSwimMotionIntensity(boidSchoolInfo, boidInfo);

    // Based on the swimming motion intensity, update the current time that drives the swimming movement motion.
    // Basically this is the time that is passed into sine functions to offset the vertices in the vertex shsader.
    UpdateSwimMotionTime(boidInfo);
    
    // Write the updated boid info into the output boids buffer at the original position of the boid. We need to
    // write to the original position since the rendering shader uses those original positions to render correct meshes.
    _BoidsOutput[boidInfo.originalIndex] = boidInfo;
}
